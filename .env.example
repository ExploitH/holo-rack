# Local development (npm run dev)
# Proxy /api, /flags and /os-icons to a real CF-Server-Monitor instead of the built-in mock.
# The Worker must list http://localhost:5173 in CORS_ALLOWED_ORIGINS only if you open it cross-origin;
# the dev proxy itself is same-origin for the browser.
DEV_API_TARGET=

# Mock backend switches (used when DEV_API_TARGET is empty)
MOCK_PRIVATE=0      # 1 = private site; log in with localStorage.jwt_token = "mock-jwt" and cookie cfsm_auth=mock-jwt
MOCK_TURNSTILE=0    # 1 = Turnstile on, using Cloudflare's always-pass test site key

# Where to find the default skin's flags/ and os-icons/ for the mock and the demo build
UPSTREAM_PUBLIC=../upstream/public

# Static hosting (GitHub Pages) — set these as repository secrets, see README
# API_BASE=https://your-worker.example.com
# TITLE=
# CSP_API=
# CSP_STATIC=
